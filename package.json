{
  "name": "codex-usage-status",
  "version": "0.1.4",
  "description": "Codex usage status with user-confirmed reset redemption via the official local app-server.",
  "type": "module",
  "private": true,
  "bin": {
    "codex-usage-status": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test ./test/*.test.js",
    "check": "node --test ./test/*.test.js",
    "test:native": "bash ./scripts/test-native.sh",
    "test:badge-animation": "bash ./scripts/test-badge-animation.sh",
    "test:reset-flow": "bash ./scripts/test-reset-redemption-flow.sh",
    "preview:badge-animations": "bash ./scripts/preview-badge-animations.sh",
    "export:readme-media": "bash ./scripts/export-readme-badge-media.sh",
    "test:swiftpm": "bash scripts/test-swiftpm.sh",
    "usage": "node ./src/cli.js",
    "usage:json": "node ./src/cli.js --json",
    "build:macos": "bash ./scripts/build-macos-app.sh",
    "start:macos": "bash ./scripts/run-macos-app.sh",
    "install:macos": "bash ./scripts/install-macos-app.sh",
    "package:macos": "bash ./scripts/package-release.sh",
    "package:macos:all": "bash ./scripts/package-all-macos.sh",
    "package:macos:dmg": "bash ./scripts/package-dmg.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
