<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.local.CodexUsageStatus</string>
	<key>ProgramArguments</key>
	<array>
		<string>__LEGACY_EXECUTABLE__</string>
		<string>preserve-this-argument</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CODEX_BIN</key>
		<string>/custom/codex/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/codex-usage-status.log</string>
</dict>
</plist>
